| get_unique_new_provinces                  | 
BEGIN
    RETURN QUERY
    SELECT DISTINCT new_province_code, new_province_name, new_province_en_name
    FROM public.merger_events
    WHERE new_province_code IS NOT NULL AND new_province_name IS NOT NULL
    ORDER BY new_province_name;
END;
                                                                                                                                                                                                                                                                                                                                                                       |
| get_new_wards_by_province                 | 
BEGIN
    RETURN QUERY
    SELECT DISTINCT new_ward_code, new_ward_name, new_ward_en_name
    FROM public.merger_events
    WHERE new_province_code = p_code
    ORDER BY new_ward_name;
END;
