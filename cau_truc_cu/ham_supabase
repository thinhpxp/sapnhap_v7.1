| get_forward_lookup_details                | 
DECLARE
    events_data JSONB;
    villages_data JSONB;
BEGIN
    -- Lấy thông tin từ bảng merger_events
    SELECT jsonb_agg(t)
    INTO events_data
    FROM merger_events t
    WHERE t.old_ward_code = p_old_ward_code;

    -- Lấy thông tin thay đổi thôn/xóm
    SELECT jsonb_agg(v)
    INTO villages_data
    FROM village_changes v
    WHERE v.old_ward_code = p_old_ward_code;

    -- Trả về một đối tượng JSON chứa cả hai
    RETURN jsonb_build_object(
        'events', COALESCE(events_data, '[]'::jsonb),
        'village_changes', COALESCE(villages_data, '[]'::jsonb)
    );
END;
 |
| get_reverse_lookup_details                | 
BEGIN
    RETURN (
        SELECT jsonb_agg(t)
        FROM (
            SELECT
                me.*,
                -- Gộp các thay đổi thôn/xóm liên quan thành một mảng JSON
                (
                    SELECT jsonb_agg(vc)
                    FROM village_changes vc
                    WHERE vc.old_ward_code = me.old_ward_code
                ) AS village_changes
            FROM
                merger_events me
            WHERE
                me.new_ward_code = p_new_ward_code
        ) t
    );
END;
